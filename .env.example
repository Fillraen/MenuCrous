# ── Discord ──────────────────────────────────────────────────────────────────
# Token du bot (https://discord.com/developers/applications → Bot → Reset Token)
DISCORD_TOKEN=

# Valeurs reprises au PREMIER démarrage seulement ; ensuite tout se règle avec /config.
# (Clic droit sur un salon → « Copier l'identifiant », mode développeur requis.)
MENU_CHANNEL_ID=
MENU_TIME=08:00
NOTES_CHANNEL_ID=

# ── Notes INSA (Mon Dossier Web) — laisser vide pour désactiver ──────────────
INSA_USERNAME=
INSA_PASSWORD=
# Ton identifiant Discord : reçoit les notes en MP, seul à pouvoir faire /notes liste
NOTES_OWNER_ID=
NOTES_URL=https://mondossierweb.insa-lyon.fr/mondossierweb/notes
NOTES_INTERVAL_MIN=30

# ── Page web ─────────────────────────────────────────────────────────────────
WEB_PORT=8080
PUBLIC_URL=
