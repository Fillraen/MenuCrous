# ── Discord ──────────────────────────────────────────────────────────────────
# Token du bot (https://discord.com/developers/applications → Bot → Reset Token)
DISCORD_TOKEN=

# Valeurs reprises au PREMIER démarrage seulement ; ensuite tout se règle avec /config.
# (Clic droit sur un salon → « Copier l'identifiant », mode développeur requis.)
MENU_CHANNEL_ID=
MENU_TIME=08:00
NOTES_CHANNEL_ID=

# ── Notes INSA (Mon Dossier Web) — laisser vide pour désactiver ──────────────
INSA_USERNAME=
INSA_PASSWORD=
# Facultatif : clé secrète TOTP (texte sous le QR code du 2FA). Sans elle, quand la session
# INSA expire, le bot demande le code en MP au propriétaire (/notes code 123456).
INSA_TOTP_SECRET=
# Ton identifiant Discord : reçoit les notes en MP, seul à pouvoir faire /notes liste
NOTES_OWNER_ID=
NOTES_URL=https://mondossierweb.insa-lyon.fr/mondossierweb/inscriptions
NOTES_INTERVAL_MIN=30

# ── Emploi du temps ADE — vide pour désactiver ───────────────────────────────
# ADE → Export → lien iCal personnel (https://ade-outils.insa-lyon.fr/ADE-Cal:~login!AAAA-AAAA:jeton)
EDT_ICS_URL=

# ── SoWeSign — vide pour désactiver ──────────────────────────────────────────
# Clé de chiffrement des comptes (codes + signatures) en base. NE PAS la perdre ni la changer :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SWS_SECRET=

# ── Page web ─────────────────────────────────────────────────────────────────
WEB_PORT=8080
PUBLIC_URL=
